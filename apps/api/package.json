    "danger": "^13.0.10",
    "eslint": "9.39.4",
    "eslint-plugin-import-typescript": "^0.0.4",
    "expect": "30.4.1",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "^0.21.1",
    "rimraf": "^6.1.3",
    "sinon": "^21.1.2",
    "supertest": "^7.2.2",
    "typeorm-to-dbml": "0.1.1",
