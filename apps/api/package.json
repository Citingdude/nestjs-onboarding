    "change-case": "^5.4.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dayjs": "^1.11.23",
    "fastify": "^5.12.4",
    "handlebars": "^4.7.9",
    "joi": "^18.2.9",
    "jose": "^6.2.12",
    "mailpit-api": "^2.1.0",
    "nestjs-i18n": "^10.8.5",
    "pg": "^8.23.0",
    "pg-query-stream": "4.17.0",
    "qs": "^6.16.0",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "1.1.1",
    "typesense": "3.0.6",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
