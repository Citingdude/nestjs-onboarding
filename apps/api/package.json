{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "imports": {
    "#src/*": "./dist/src/*",
    "#test/*": "./dist/src/test/*"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "nest build",
    "type-check": "tsc --noEmit",
    "post-build": "pnpm generate:async-api && pnpm generate:erd",
    "dev": "nest start --exec \"node --env-file=.env\" --watch",
    "dev:worker": "PORT=3001 nest start worker --exec \"node --env-file=.env\" --watch -- --queue system --queue nats-outbox --supervise",
    "lint:fix": "oxlint --fix && eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:eslint": "eslint --cache",
    "lint:oxlint": "oxlint --type-aware -c .oxlintrc.json",
    "lint": "pnpm lint:eslint",
    "test:setup": "echo setup",
    "test:mail": "node --enable-source-maps --experimental-test-isolation=none --env-file=.env.test --test \"**/mail-pit-validation.e2e.test.js\"",
    "test:core": "node --enable-source-maps --experimental-test-isolation=none --test-global-setup=dist/src/modules/test-setup/global-setup.js --env-file=.env.test --test \"**/*.test.js\"",
    "test:run": "pnpm test:core && pnpm test:mail",
    "test:all": "pnpm clean && pnpm build && pnpm test:run",
    "test:one": "pnpm clean && pnpm build && node --enable-source-maps --experimental-test-isolation=none --env-file=.env.test --test --test-reporter=spec",
    "typeorm": "pnpm clean && pnpm build && node --env-file=.env ./node_modules/typeorm/cli -d ./dist/src/sql/sources/main.js",
    "translate": "tsc6 --build tsconfig.translate.json && node --env-file=.env.test dist/src/scripts/generate-translations.js",
    "generate:async-api": "node dist/src/scripts/generate-async-api.js",
    "generate:erd": "typeorm-to-dbml './src/**/*.entity.ts' './dist/src/modules/erd/erd.dbml'",
    "jetstream:migration:create": "node --env-file=.env dist/src/modules/nats/nats-application/streams/create-jetstream-migration.js",
    "depcheck": "pnpx depcheck --ignores=rimraf"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/lib-storage": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/jwt": "0.0.10-5",
    "@nats-io/kv": "^3.4.0",
    "@nats-io/nkeys": "^2.0.3",
    "@nats-io/services": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "11.1.24",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "11.0.3",
    "@onesignal/node-onesignal": "5.4.0-beta1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.217.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.217.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.217.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.217.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@repo/types": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@wisemen/address": "0.5.3",
    "@wisemen/api-error": "1.1.0",
    "@wisemen/app-container": "6.0.1",
    "@wisemen/coordinates": "0.1.2",
    "@wisemen/csv": "1.0.1",
